{
    "python.analysis.include": ["apps"],
    "python.analysis.exclude": [
        "tmp",
        "**/node_modules",
        "**/__pycache__",
        "**/.git",
        "**/.venv",
        "**/venv",
        "**/.build",
        "**/.swiftpm",
        "**/target",
        "**/*.app"
    ],
    "python.analysis.diagnosticMode": "openFilesOnly",
    "cSpell.words": [
        "backref",
        "brackethighlighter",
        "cuda",
        "filesdb",
        "Gday",
        "nums",
        "octicon",
        "prettylights",
        "pyannote",
        "pyproject",
        "runpod",
        "sublimelinter",
        "whisperx"
    ]
}
