PAYLOAD_SECRET=replace-with-at-least-32-random-characters
SERVER_URL=http://localhost:3000
DATABASE_ADAPTER=sqlite
DATABASE_URI=file:./data/gday.db
# For postgres: DATABASE_ADAPTER=postgres and DATABASE_URI=postgresql://...

# Optional: Gday-owned transcription (configure both to enable execution).
# RUNPOD_ENDPOINT_URL=https://api.runpod.ai/v2/your-endpoint-id
# RUNPOD_API_KEY=your-runpod-api-key

# Optional linked external OIDC sign-in. Gday remains the source of users/roles.
# Configure all three, then link an existing account from /account.
# OIDC_UPSTREAM_ISSUER=https://identity.example.com
# OIDC_UPSTREAM_CLIENT_ID=gday-meetings
# OIDC_UPSTREAM_CLIENT_SECRET=your-provider-client-secret
# Optional auth storage override: local path/file: URI for SQLite, Postgres URI for postgres.
# AUTH_DATABASE_URI=
