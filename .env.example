PAYLOAD_SECRET=replace-with-at-least-32-random-characters
GDAY_API_TOKEN=replace-with-a-random-service-token
SERVER_URL=http://localhost:3000
DATABASE_ADAPTER=sqlite
DATABASE_URI=file:./data/gday.db
# For postgres: DATABASE_ADAPTER=postgres and DATABASE_URI=postgresql://...
# Optional dedicated read-only MCP credential (otherwise uses GDAY_API_TOKEN):
# GDAY_MCP_TOKEN=replace-with-an-independent-random-token
